# Test overrides
APP_ENV=test
APP_DEBUG=0
DATABASE_URL="postgresql://user:password@postgres-db-test:5432/event_sourcing_test?serverVersion=16&charset=utf8"
MESSENGER_DATABASE_URL="postgresql://queue_user:queue_password@queue-db-test:5432/messenger_queue_test?serverVersion=16&charset=utf8"
QUEUE_BACKEND=postgres
MESSENGER_TRANSPORT_DSN_POSTGRES="doctrine://messaging?queue_name=async&auto_setup=1"
MESSENGER_FAILED_TRANSPORT_DSN_POSTGRES="doctrine://messaging?queue_name=failed&auto_setup=1"
MESSENGER_TRANSPORT_DSN_REDIS="appredis://redis-test:6379/async"
MESSENGER_FAILED_TRANSPORT_DSN_REDIS="appredis://redis-test:6379/failed"
MESSENGER_TRANSPORT_DSN_KAFKA="appkafka://kafka-test:9092/async"
MESSENGER_FAILED_TRANSPORT_DSN_KAFKA="appkafka://kafka-test:9092/failed"
MESSENGER_KAFKA_GROUP_ID="messenger-test-async-group"
MESSENGER_KAFKA_FAILED_GROUP_ID="messenger-test-failed-group"
MONGODB_URL="mongodb://root:password@mongodb-test:27017"
MONGODB_DB="event_sourcing_test"
LOCK_DSN=flock

# n8n Test overrides
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres-db-test
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=event_sourcing_test
DB_POSTGRESDB_USER=user
DB_POSTGRESDB_PASSWORD=password
WEBHOOK_URL=http://localhost:9678/
