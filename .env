# Docker Environment
PORT=8080
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=event_sourcing_dev
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
NODE_ENV=development
WEBHOOK_URL=http://n8n:5678/
N8N_WEBHOOK_BOOKING_URL=http://n8n:5678/webhook/booking-ready
N8N_WEBHOOK_QUOTE_SENT_URL=http://n8n:5678/webhook/quote-sent
N8N_WEBHOOK_START_QUOTE_URL=http://n8n:5678/webhook/start-quote
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres-db
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=event_sourcing_dev
DB_POSTGRESDB_USER=user
DB_POSTGRESDB_PASSWORD=password

# Symfony Environment
APP_ENV=dev
APP_SECRET=a6215b43b4bc1a07a22623384e62cc4a
DATABASE_URL="postgresql://user:password@postgres-db:5432/event_sourcing_dev?serverVersion=16&charset=utf8"
LOCK_DSN="semaphore"
SNAPSHOT_THRESHOLD=5
MONGODB_URL="mongodb://root:password@mongodb:27017"
MONGODB_DB="event_sourcing"
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

###> symfony/messenger ###
# Queue backend switch: postgres | redis | kafka
QUEUE_BACKEND=kafka

MESSENGER_DATABASE_URL="postgresql://queue_user:queue_password@queue-db:5432/messenger_queue?serverVersion=16&charset=utf8"
MESSENGER_TRANSPORT_DSN_POSTGRES="doctrine://messaging?queue_name=async&auto_setup=1"
MESSENGER_FAILED_TRANSPORT_DSN_POSTGRES="doctrine://messaging?queue_name=failed&auto_setup=1"

MESSENGER_TRANSPORT_DSN_REDIS="appredis://redis:6379/async"
MESSENGER_FAILED_TRANSPORT_DSN_REDIS="appredis://redis:6379/failed"

MESSENGER_TRANSPORT_DSN_KAFKA="appkafka://kafka:9092/async"
MESSENGER_FAILED_TRANSPORT_DSN_KAFKA="appkafka://kafka:9092/failed"
MESSENGER_KAFKA_GROUP_ID="messenger-async-group"
MESSENGER_KAFKA_FAILED_GROUP_ID="messenger-failed-group"
###< symfony/messenger ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###
